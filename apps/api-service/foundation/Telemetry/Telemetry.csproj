<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--<Version>$(TelemetryVersion)</Version>-->
    <AssemblyName>Aurore.Foundation.Telemetry</AssemblyName>
    <RootNamespace>Aurore.Foundation.Telemetry</RootNamespace>
    <Product>Aurore Foundation @ Telemetry</Product>
    <Description>Telemetry extensions and utilities for aurore projects.</Description>
    <PackageTags>aurore telemetry extensions utilities helpers</PackageTags>

    <!-- Required for OpenTelemetry packages that are on beta -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU5104</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.2.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.20.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Process" Version="1.15.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tests.Telemetry" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
  </ItemGroup>

</Project>
