{
  // Host names this service answers to (semicolon-separated). "*" in appsettings.json allows any.
  // Behind a reverse proxy that already filters hosts this is optional; set it when the app is reachable directly.
  // "AllowedHosts": "api.example.com;api.internal.example.com",

  // Required: production origins. The app refuses to start while a localhost origin from appsettings.json is in effect.
  // Keys/array positions override appsettings.json; an empty array or object does NOT clear the development values.
  // "CorsPolicies": {
  //   "Default": {
  //     "AllowedOrigins": [ "https://app.example.com" ]
  //   }
  // },

  "IdentityProvider": {
    // "AuthorityUrl": "https://auth.example.com/realms/aurorelabs",
    "RequireHttpsMetadata": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore.Authentication": "Warning",
      "Microsoft.IdentityModel": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "RequestPipeline": {
    // Trust the reverse proxy / load balancer in front of the app so X-Forwarded-For/Proto/Host are honored.
    // Without this, only loopback is trusted: client IPs and the request scheme would be the proxy's.
    // "ForwardedHeaders": {
    //   "KnownProxies": [ "10.0.0.10" ],
    //   "KnownNetworks": [ "10.0.0.0/24" ]
    // },

    // Turn off when the reverse proxy already compresses responses.
    // "ResponseCompression": {
    //   "IsEnabled": false
    // }
  }

  // "Telemetry": {
  //   "CollectorEndpoint": "http://otel-collector.internal:4317"
  // }
}
