{
  // Host names this service answers to (semicolon-separated). "*" in appsettings.json allows any.
  // Behind a reverse proxy that already filters hosts this is optional; set it when the app is reachable directly.
  // "AllowedHosts": "api.example.com;api.internal.example.com",

  "IdentityProvider": {
    // "AuthorityUrl": "https://auth.example.com/realms/aurorelabs",
    "RequireHttpsMetadata": true
  },
  // The database. A local host is refused in Production, so set the real one, with the password only through the environment:
  // Postgres__Host, Postgres__Database, Postgres__Username, Postgres__Password and, advisably, Postgres__SslMode=Require.
  // "Postgres": {
  //   "Host": "<db host>",
  //   "Database": "<database name>",
  //   "Username": "<user>"
  // },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore.Authentication": "Warning",
      "Microsoft.IdentityModel": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Update": "Critical",
      "Microsoft.AspNetCore.DataProtection": "Error",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "RequestPipeline": {
    // Encrypts personal data (client address, user agent, user id) in logs and traces. Keys come from environment variables:
    // RequestPipeline__Privacy__Keys__Current (32 random bytes, base64) and RequestPipeline__Privacy__Keys__Previous__0, __1, ... for old keys.
    // Generate one with: https://github.com/aurorelabs/foundation/blob/main/docs/scripts/privacy.cs (dotnet run privacy.cs -- generate-key)
    "Privacy": {
      "Enabled": true
    },

    // Optional: only when a browser app calls this service directly from another origin (normally nginx or a gateway owns CORS).
    // A localhost origin is refused in Production.
    // "CorsPolicies": {
    //   "Default": {
    //     "AllowedOrigins": [ "https://app.example.com" ]
    //   }
    // },

    // Trust the reverse proxy / load balancer in front of the app so X-Forwarded-For/Proto/Host are honored.
    // Without this, only loopback is trusted: client IPs and the request scheme would be the proxy's.
    // "ForwardedHeaders": {
    //   "KnownProxies": [ "10.0.0.10" ],
    //   "KnownNetworks": [ "10.0.0.0/24" ]
    // },

    // Turn off when the reverse proxy already compresses responses.
    // "ResponseCompression": {
    //   "Enabled": false
    // }
  }

  // "Telemetry": {
  //   "Otlp": {
  //     "Endpoint": "http://otel-collector.internal:4317"
  //   }
  // }
}
