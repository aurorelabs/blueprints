<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>Blueprints.ApiService</AssemblyName>
    <RootNamespace>Aurore.Blueprints.ApiService.App.Api</RootNamespace>
    <!-- Service version (AppInformation.Version, telemetry, liveness). CI overrides it: dotnet publish -p:Version=1.4.2 -->
    <Version>1.0.0</Version>
    <!--Explicit permission used by OpenAPI source generation-->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Microsoft.AspNetCore.OpenApi.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Tests.Integration" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\Features\Features.csproj" />
    <ProjectReference Include="..\Infra\Infra.csproj" />
  </ItemGroup>

</Project>
