{
  "AllowedHosts": "*",
  "AppInformation": {
    "Domain": "Blueprints",
    "Boundary": "Apps",
    "Component": "ApiService",
    "Description": "API service to showcase our best practices and standards.",
    "Maintainer": {
      "Name": "core-apps",
      "Email": "teams.core-apps@aurorelabs.com"
    },
    "Locale": "en-US"
  },
  "ApiKeys": {
    "HeaderName": "AL-Api-Key",
    "Clients": {
      "local-tester": {
        "Key": "local-dev-api-key",
        "Roles": [ "reader" ],
        "Scopes": [ "api.read" ]
      }
    }
  },
  "CorsPolicies": {
    "Default": {
      "AllowedHeaders": [],
      "AllowedMethods": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "AllowedOrigins": [
        "http://localhost:4200"
      ],
      "ExposedHeaders": [],
      "AllowCredentials": false,
      "PreflightMaxAgeSeconds": 600
    }
  },
  "Dependencies": {
    "RandomUser": {
      "BaseUrl": "https://randomuser.me",
      "RequestHeaders": {},
      "PropagateCorrelationId": true,
      "HealthCheck": {
        "ReadinessEndpoint": "/api",
        "TimeoutSeconds": 5,
        "IsCritical": false,
        "Tags": []
      }
    },
    "GitHub": {
      "BaseUrl": "https://api.github.com",
      "RequestHeaders": {
        "Accept": "application/vnd.github+json",
        "User-Agent": "aurore-blueprints-apiservice",
        "X-GitHub-Api-Version": "2022-11-28"
      },
      "PropagateCorrelationId": false
    },
    "Orders": {
      "BaseUrl": "http://orders.localhost:5002",
      "ClientCredentials": {
        "TokenUrl": "http://auth.localhost:9999/realms/aurorelabs/protocol/openid-connect/token",
        "ClientId": "api-service",
        "ClientSecret": "local-dev-secret",
        "Scopes": [ "orders.read" ]
      }
    },
    "Inventory": {
      "BaseUrl": "http://inventory.localhost:5003",
      "ApiKey": {
        "HeaderName": "X-Api-Key",
        "Value": "local-dev-inventory-key"
      }
    }
  },
  "HealthChecks": {
    "CacheSeconds": 5
  },
  "IdentityProvider": {
    "AuthorityUrl": "http://auth.localhost:9999/realms/aurorelabs",
    "Audience": "api",
    "RequireHttpsMetadata": false,
    "Scopes": {
      "api.read": "Read access to the API",
      "api.write": "Write access to the API"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",

      "Microsoft": "Warning",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Microsoft.IdentityModel": "Debug",
      "Microsoft.Hosting.Lifetime": "Information",

      "Microsoft.AspNetCore.Hosting": "Warning",
      "Microsoft.AspNetCore.Mvc": "Warning",
      "Microsoft.AspNetCore.Routing": "Warning",

      "Microsoft.EntityFrameworkCore": "Information",
      "System.Net.Http.HttpClient": "Information"
    }
  },
  "MaintenanceMode": {
    "Enabled": false,
    "Message": null,
    "RetryAfterSeconds": 60
  },
  "RequestPipeline": {
    "ForwardedHeaders": {
      "KnownProxies": [],
      "KnownNetworks": []
    },
    "Idempotency": {
      "CacheDurationMinutes": 1440
    },
    "KestrelLimits": {
      "MaxConcurrentConnections": null,
      "MaxRequestHeaderCount": 100,
      "RequestHeadersTimeoutSeconds": 30,
      "KeepAliveTimeoutSeconds": 130,
      "MaxRequestBodySizeBytes": 10485760
    },
    "RateLimiting": {
      "Policies": {
        "tests": {
          "PermitLimit": 3,
          "WindowSeconds": 10
        },
        "standard": {
          "PermitLimit": 100,
          "WindowSeconds": 60
        }
      }
    },
    "ResponseCompression": {
      "IsEnabled": true,
      "EnableForHttps": true
    },
    "SecurityHeaders": {
      "ContentSecurityPolicy": "default-src 'none'; frame-ancestors 'none'"
    },
    "Timeouts": {
      "DefaultSeconds": 100,
      "Policies": {
        "long-running": 300
      }
    }
  },
  "Telemetry": {
    "CollectorEndpoint": "http://localhost:4317",
    "Protocol": "Grpc",
    "ResourceAttributes": {},
    "Logging": {
      "IncludeScopes": true,
      "ParseStateValues": true
    },
    "Metrics": {
      "ExportToConsole": false
    },
    "Tracing": {
      "TraceIdRatioBasedSampler": 1.0,
      "IncomingTrafficFilters": [],
      "OutgoingTrafficFilters": [],
      "ExportToConsole": false
    }
  }
}
