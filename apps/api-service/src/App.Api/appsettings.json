{
  "AllowedHosts": "*",
  "AppInformation": {
    "Domain": "Blueprints",
    "Boundary": "Apps",
    "Component": "ApiService",
    "Description": "API service to showcase our best practices and standards.",
    "Maintainer": {
      "Name": "core-apps",
      "Email": "teams.core-apps@aurorelabs.com",
      "Url": "https://aurorelabs.com/teams/core-apps"
    },
    "Locale": "en-US"
  },
  "ApiDocs": {
    "OAuthClientId": "api-docs"
  },
  "ApiKeys": {
    "HeaderName": "X-Api-Key",
    "Clients": {
      "local-tester": {
        "Key": "local-dev-api-key",
        "Roles": [ "reader" ],
        "Scopes": [ "api.read" ]
      }
    }
  },
  "Pagination": {
    "DefaultPageSize": 20,
    "MaxPageSize": 100
  },
  "HealthChecks": {
    "CacheSeconds": 5
  },
  "Hosting": {
    "ShutdownTimeoutSeconds": 10
  },
  "HttpDependencies": {
    "RandomUser": {
      "BaseUrl": "https://randomuser.me",
      "RequestHeaders": {},
      "PropagateCorrelationId": true,
      "HealthCheck": {
        "ReadinessEndpoint": "/api",
        "TimeoutSeconds": 5,
        "Critical": false,
        "Tags": []
      }
    },
    "GitHub": {
      "BaseUrl": "https://api.github.com",
      "RequestHeaders": {
        "Accept": "application/vnd.github+json",
        "User-Agent": "aurore-blueprints-apiservice",
        "X-GitHub-Api-Version": "2022-11-28"
      },
      "PropagateCorrelationId": false
    },
    "Orders": {
      "BaseUrl": "http://orders.localhost:5002",
      "ClientCredentials": {
        "TokenUrl": "http://auth.localhost:9999/realms/aurorelabs/protocol/openid-connect/token",
        "ClientId": "api-service",
        "ClientSecret": "local-dev-secret",
        "Scopes": [ "orders.read" ]
      }
    },
    "Inventory": {
      "BaseUrl": "http://inventory.localhost:5003",
      "ApiKey": {
        "HeaderName": "X-Api-Key",
        "Value": "local-dev-inventory-key"
      }
    }
  },
  "IdentityProvider": {
    "AuthorityUrl": "http://auth.localhost:9999/realms/aurorelabs",
    "Audience": "api",
    "RequireHttpsMetadata": false,
    "Provider": "Keycloak",
    "ClockSkewSeconds": 30,
    "Scopes": {
      "api.read": "Read access to the API",
      "api.write": "Write access to the API"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",

      "Microsoft": "Warning",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Microsoft.IdentityModel": "Debug",
      "Microsoft.Hosting.Lifetime": "Information",

      "Microsoft.AspNetCore.Hosting": "Warning",
      "Microsoft.AspNetCore.Mvc": "Warning",
      "Microsoft.AspNetCore.Routing": "Warning",

      "Microsoft.EntityFrameworkCore": "Information",
      "System.Net.Http.HttpClient": "Information"
    }
  },
  "RequestPipeline": {
    "CorsPolicies": {},
    "ForwardedHeaders": {
      "KnownProxies": [],
      "KnownNetworks": []
    },
    "Idempotency": {
      "CacheDurationSeconds": 86400
    },
    "KestrelLimits": {
      "MaxConcurrentConnections": null,
      "MaxRequestHeaderCount": 100,
      "RequestHeadersTimeoutSeconds": 30,
      "KeepAliveTimeoutSeconds": 130,
      "MaxRequestBodySizeBytes": 10485760
    },
    "OutputCache": {
      "Policies": {
        "short": {
          "ExpirationSeconds": 10,
          "VaryByQuery": [ "*" ],
          "VaryByHeader": []
        }
      }
    },
    "Privacy": {
      "Enabled": false,
      "ProtectedFields": [],
      "Keys": {
        "Current": "",
        "Previous": []
      }
    },
    "RateLimiting": {
      "Policies": {
        "tests": {
          "PermitLimit": 3,
          "WindowSeconds": 10
        },
        "standard": {
          "PermitLimit": 100,
          "WindowSeconds": 60
        }
      }
    },
    "ResponseCompression": {
      "Enabled": true,
      "EnableForHttps": true
    },
    "SecurityHeaders": {
      "ContentSecurityPolicy": "default-src 'none'; frame-ancestors 'none'"
    },
    "Timeouts": {
      "DefaultSeconds": 100,
      "Policies": {
        "long-running": 300
      }
    }
  },
  "Telemetry": {
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "Grpc",
      "RequestTimeoutSeconds": 10
    },
    "ResourceAttributes": {},
    "Logging": {
      "IncludeScopes": true,
      "ParseStateValues": true,
      "BatchExport": {
        "MaxQueueSize": 2048,
        "MaxExportBatchSize": 512,
        "ScheduledDelaySeconds": 5,
        "ExportTimeoutSeconds": 30
      }
    },
    "Metrics": {
      "ExportToConsole": false,
      "ExportIntervalSeconds": 60,
      "ExportTimeoutSeconds": 30
    },
    "Tracing": {
      "SamplingRatio": 1.0,
      "ExcludedIncomingPaths": [],
      "ExcludedOutgoingPaths": [],
      "ExportToConsole": false,
      "BatchExport": {
        "MaxQueueSize": 2048,
        "MaxExportBatchSize": 512,
        "ScheduledDelaySeconds": 5,
        "ExportTimeoutSeconds": 30
      }
    }
  }
}
