<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>

        <!-- Language Settings -->
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>

        <!-- Company Information -->
        <Authors>Aurore Development</Authors>
        <Company>AuroreLabs</Company>
        <Copyright>AuroreLabs</Copyright>

        <!-- Code Style Enforcement -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    </PropertyGroup>

    <!-- Auto-detect test projects by path pattern -->
    <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('\tests\')) Or $(MSBuildProjectDirectory.Contains('/tests/'))">
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>
</Project>
